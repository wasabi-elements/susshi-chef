%h3 Welcome to suSSHi Chef
%p Sorry to bother you with another question ...
%h4 Please enter your One-Time Password

= form_for("", url: users_sessions_verify_otp_path, method: :post, html: { role: 'form', class: 'm-t'}) do |f|
  .form-group
    = f.password_field :otp_attempt, autofocus: true, class: 'form-control', :placeholder => "OTP"
  = f.submit  'Verify', class: 'btn btn-primary block full-width m-b'

- if flash[:error]
  %p.text-danger= flash[:error]
