- breadcrumb @target_network

= panel do
  = attributes_table do
    = row_key_value 'Partition', @target_network.partition.name, icon: 'fa-cube'
    = row_key_value 'Network', @target_network.network, icon: @target_network.icon
    = row_key_value_block 'Active', icon: 'fa-lightbulb' do
      = boolean_value(@target_network.active)
    = row_key_values 'Memberships', @target_network.target_groups.collect {|t| link_to t.name, t }, icon: 'fa-layer-group'
    - if @target_network.target_fusions.any?
      = row_key_values 'Target Fusions', @target_network.target_fusions.collect {|fusion| link_to fusion.display_name, fusion}, icon: 'fa-link'

  - k = @target_network.target_user_host_keys
  - if k.any?
    = render partial: 'shared/target_host_keys', locals: { title: 'User-individual Hostkeys', target_host_keys: k }

  = show_action_buttons(@target_network, { :destroy => @target_network.is_destroyable? })