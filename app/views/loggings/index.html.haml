= search_form_for @q, :remote => true, :class => 'auto_submit_on_change' do |f|
  %table.search_filter
    %tr
      %th Severity
      %th Facility Class
      %th Text
      %th User
    %tr
      %td= f.select :severity_start, Logging.severities_selector_collection, { :include_blank => 'All / System' }
      %td= f.select :facility_class_matches, Logging.facility_classes_selector_collection, { :include_blank => 'All' }
      %td= f.text_field :text_cont, :placeholder => "contains"
      %td= f.select :user_id_eq, Logging.users_selector_collection, { :include_blank => 'All' }
      = searchform_action_buttons

= render(:partial => 'shared/paginator', :locals => { :objects => @loggings })

%table.index_table.index
  %thead#loggings_thead
    = render :partial => 'thead'
  %tbody#loggings_body
    = render :partial => 'logging', :collection => @loggings