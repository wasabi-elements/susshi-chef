- unless request.xhr?
  - breadcrumb @client_auth_set

= panel do
  %h3 Client Auth Set
  = attributes_table do
    = row_key_value 'Partition', @client_auth_set.partition.name, icon: 'fa-cube'
    = row_key_value 'Name', @client_auth_set.name, icon: 'fa-toggle-on'
    = row_key_value 'Description', @client_auth_set.description, icon: 'fa-info' unless @client_auth_set.description.blank?
    = row_key_value 'Comment', @client_auth_set.comment, icon: 'fa-comment' unless @client_auth_set.comment.blank?
    = row_key_value 'Required Methods', @client_auth_set.auth_logic_human, icon: 'fa-sign-in-alt'
    = row_key_value_block 'IP Session Cache', icon: "fa-toggle-#{@client_auth_set.cache_enabled ? 'on' : 'off'}" do
      = @client_auth_set.cache_enabled ? 'Enabled' : 'Disabled'

  %h3 Public Key Authentication
  = attributes_table do
    = row_key_value 'Authentication Method', @client_auth_set.publickey_client_auth.try(:human_type) || '-', icon: 'fa-key'

  %h3 Interactive Authentication
  = attributes_table do
    = row_key_value 'Authentication Method', @client_auth_set.interactive_client_auth.try(:human_type) || '-', icon: 'fa-key'
    - int_auth = @client_auth_set.interactive_client_auth
    - unless int_auth.blank?
      - if int_auth.class.const_defined? 'PROPERTIES'
        - int_auth.class.const_get('PROPERTIES').each do |property, options|
          - value = int_auth.try(property)
          - if options[:as] == :boolean
            = row_key_value_block options[:title] || options[:label], icon: "fa-toggle-#{value ? 'on' : 'off'}" do
              = value ? 'Enabled' : 'Disabled'
          - else
            = row_key_value_block options[:label], icon: options[:icon] do
              - if value.blank? && options[:placeholder]
                %pre= "#{options[:placeholder].strip} (default)"
              - elsif options[:as] == :password
                %pre= value.to_s.gsub(/\S/, '*')
              - else
                %pre= value

  - if @client_auth_set.cache_enabled
    %h3 IP Session Cache
    = attributes_table do
      = row_key_value 'Max. Cache Time', @client_auth_set.max_cache_time, icon: 'fa-clock'
      = row_key_value_block 'Refresh Idle Timer', icon: "fa-toggle-#{@client_auth_set.cache_refresh ? 'on' : 'off'}" do
        = @client_auth_set.cache_refresh == true ? 'Refresh idle timer on subsequent successful user authentications' : 'No refresh'
      - if @client_auth_set.cache_refresh == true
        = row_key_value 'Cache Idle Time', @client_auth_set.cache_idle_time, icon: 'fa-clock'
      = row_key_value 'Required Methods (when cached)', @client_auth_set.auth_logic_human(cached: true), icon: 'fa-sign-in-alt'

      - if @client_auth_set.cache_whitelist.present?
        = row_key_value_block "Whitelist", icon: "fa-network-wired" do
          - @client_auth_set.cache_whitelist.each do |entry|
            %div= entry

  - unless request.xhr?
    = show_action_buttons(@client_auth_set, { :destroy => @client_auth_set.is_destroyable? })
