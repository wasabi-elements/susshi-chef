= simple_form_for(@partition_key) do |f|
  = f.error_notification

  = f.input :partition_id, as: :hidden
  = f.fields_for :partition do
    = f.input_with_icon :partition_name, disabled: true, icon: 'fa-cube', input_html: { value: @partition_key.partition.name }, label: 'Partition'

  = f.input_with_icon :title, label: 'Title', icon: "fa-info-circle"

  = f.input_with_icon :key_type, collection: SshKey.ssh_key_type_collection, label: 'Key Type', icon: 'fa-key'

  = f.input_with_icon :bits, collection: [], label: 'Key length (bits)', icon: 'fa-expand'

  .checkbox.checkbox-primary
    = f.input :active, label: 'Key is active'


  = f.button :submit_cancel, html: { class: 'btn-primary' }, cancel: :back

:javascript
  $('##{@partition_key.type.underscore}_key_type').change(function() {
    var source = $(this);
    var target = $('##{@partition_key.type.underscore}_bits');
    var bits;
    switch(source.val()) {
      case 'ssh-rsa':
        bits = [1024, 2048, 4096];
        break;
      case 'ssh-ed25519':
        bits = [256];
        break;
      case 'ecdsa-sha2-nistp256':
        bits = [256];
        break;
      case 'ecdsa-sha2-nistp384':
        bits = [384];
        break;
      case 'ecdsa-sha2-nistp521':
        bits = [521];
        break;
      default:
        bits = [];
    }
    target.empty();
    $.each(bits, function(index, value) {
      target.append($("<option></option>").attr("value", value).text(value));
    });
    target.trigger("chosen:updated");

  });
  $('##{@partition_key.type.underscore}_key_type').change();