%br
%h2 Subscription details
.hr-line-dashed

= attributes_table do
  = row_key_value 'Subscription for Company', subscription.company, icon: 'fa-cube'
  = row_key_value 'User', subscription.user, icon: 'fa-user'
  = row_key_value 'Installation ID', subscription.installation_id, icon: 'fa-star'
  = row_key_value_block 'Valid not before', icon: 'far fa-clock' do
    - if subscription.valid_not_before > Time.now
      %span.btn.btn-xs.btn-danger= subscription.valid_not_before
    - else
      = subscription.valid_not_before
  = row_key_value_block 'Valid not after', icon: 'far fa-clock' do
    - if subscription.valid_not_after < Time.now
      %span.btn.btn-xs.btn-danger= subscription.valid_not_after
    - elsif subscription.expires_soon?
      %span.btn.btn-xs.btn-warning= subscription.valid_not_after
    - else
      = subscription.valid_not_after

  = row_key_value 'Last Refresh', subscription.activated_at, icon: 'fa-clock'

  - if lookup_context.exists?("ee/subscriptions/pull_status_ee", [], true)
    = render partial: "ee/subscriptions/pull_status_ee", locals: { subscription: }

  - list = [ ['Gateway Users', subscription.users, subscription.configured_users, 'fa-users'],
             ['Targets', subscription.targets, subscription.configured_targets, 'fa-server'] ]
  - list.each do |name, lic, count, icon|
    = row_key_value_block name, icon: icon do
      %span
      - if count > 0
        - if lic == count
          %span.btn.btn-xs.btn-warning= lic
        - else
          - if lic > count
            %span.btn.btn-xs.btn-primary= lic
          - else
            %span.btn.btn-xs.btn-danger= lic
      - else
        %span.btn.btn-xs.btn-primary= lic
      %span= "( #{count} in use )"

  = row_key_value 'Features', subscription.features.join(', '), icon: 'fa-star'
  - if subscription.errors.any?
    = render partial: "activation_problems"
